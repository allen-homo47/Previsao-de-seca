@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sistema de Classificação de Seca</title>
    <style>
            body {
                font-family: Arial, sans-serif;
                background: #f1f5f9;
                margin: 0;
                text-align: center;
            }

            header {
                background: #14532d;
                color: white;
                padding: 25px;
            }

            main {
                margin: 70px auto;
                padding: 20px;
                max-width: 800px;
            }

            .card {
                background: white;
                padding: 35px;
                border-radius: 12px;
                box-shadow: 0 4px 12px #00000015;
            }

            button {
                background: #15803d;
                color: white;
                border: none;
                padding: 14px 25px;
                border-radius: 8px;
                cursor: pointer;
            }
    </style>
</head>
<body>
    <header>
        <h1>Sistema de Classificação de Seca</h1>
        <p>Monitoria Inteligente da Humidade do Solo</p>
    </header>

    <main>
        <div class="card">
            <h2>Bem-vindo!</h2>
            <p>
                Esta plataforma utiliza Inteligência Artificial
                para classificar os níveis de seca nas regiões
                de Chókwè e Massinga, em Moçambique.
            </p>

            <button type="button" disabled>
                Consultar Classificação
            </button>
        </div>
    </main>
</body>
</html>
