@model Sistema_Classificacao_Seca.Controllers.HomeDashboard
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sistema de Previsão de Seca</title>
    <style>
        :root {
            --bg: #f3faf4;
            --panel: #ffffff;
            --primary: #14532d;
            --primary-dark: #0f3d2b;
            --secondary: #1d4ed8;
            --text: #132d1f;
            --muted: #4d6856;
            --shadow: rgba(15, 61, 43, 0.12);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: linear-gradient(180deg, #edf8ef 0%, #f8fbf8 100%);
            color: var(--text);
        }

        .header {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary));
            color: white;
            padding: 2rem 1rem;
            box-shadow: 0 8px 24px var(--shadow);
        }

        .header-inner {
            max-width: 1100px;
            margin: 0 auto;
            text-align: center;
        }

        .header h1 {
            margin: 0;
            font-size: clamp(2rem, 4vw, 3rem);
        }

        .header p {
            margin: .5rem 0 0;
            font-size: 1.05rem;
            opacity: .9;
        }

        .main {
            max-width: 1100px;
            margin: 2.5rem auto;
            padding: 0 1rem 3rem;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.5rem;
        }

        .card {
            background: var(--panel);
            border-radius: 18px;
            padding: 1.5rem;
            box-shadow: 0 14px 30px var(--shadow);
            border: 1px solid rgba(20, 83, 45, 0.1);
        }

        .badge {
            display: inline-block;
            background: #dfeef2;
            color: var(--secondary);
            border-radius: 999px;
            padding: .4rem .7rem;
            font-size: .8rem;
            font-weight: 700;
            margin-bottom: .75rem;
        }

        .card h2 {
            margin: 0 0 .75rem;
            font-size: 1.7rem;
        }

        .card p {
            color: var(--muted);
            line-height: 1.7;
            margin-bottom: 1.2rem;
        }

        .button-row {
            display: flex;
            gap: .75rem;
            flex-wrap: wrap;
        }

        .button {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary), #1f7a43);
            color: white;
            text-decoration: none;
            border-radius: 10px;
            padding: .9rem 1.2rem;
            font-weight: 700;
        }

        .button.secondary {
            background: white;
            color: var(--primary);
            border: 1px solid rgba(20, 83, 45, 0.25);
        }

        .header-row {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .auth-actions { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
        .auth-actions a, .auth-actions button {
            color: white;
            border: 1px solid rgba(255,255,255,.45);
            background: transparent;
            border-radius: 8px;
            padding: .5rem .75rem;
            text-decoration: none;
            font: inherit;
            cursor: pointer;
        }
        .auth-actions form { margin: 0; }
        .auth-name { color: white; opacity: .9; }
        .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
        .metric { background: white; padding: 1.25rem; border-radius: 14px; box-shadow: 0 8px 20px var(--shadow); }
        .metric span { color: var(--muted); display: block; }
        .metric strong { display: block; font-size: 1.8rem; margin-top: .3rem; }
        .section-title { margin: 1.5rem 0 .75rem; }
        .region-list { display: grid; gap: .75rem; }
        .region-row { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem; background: white; border-radius: 12px; }
        .notice { background: #fff7df; border-left: 4px solid #d99a00; padding: .85rem 1rem; border-radius: 8px; }
    </style>
</head>
<body>
    <header class="header">
        <div class="header-row">
            <div class="header-inner">
                <h1>Sistema de Previsão de Seca</h1>
                <p>Dashboard de monitoria — Chókwè e Massinga, Moçambique</p>
            </div>
            <partial name="_LoginPartial" />
        </div>
    </header>

    <main class="main">
        @if (Model.LatestObservationDate is { } latestDate && (DateTime.Today - latestDate.Date).TotalDays > 120)
        {
            <p class="notice" role="status">Os dados mais recentes são de @latestDate.ToString("dd/MM/yyyy"). Actualize as observações para uma análise operacional actual.</p>
        }

        <section class="metrics" aria-label="Resumo do sistema">
            <div class="metric"><span>Observações registadas</span><strong>@Model.ObservationCount</strong></div>
            <div class="metric"><span>Regiões com dados</span><strong>@Model.RegionCount</strong></div>
            <div class="metric"><span>Última observação</span><strong>@(Model.LatestObservationDate?.ToString("dd/MM/yyyy") ?? "Sem dados")</strong></div>
        </section>

        <h2 class="section-title">Cobertura por região</h2>
        <section class="region-list">
            @if (Model.Regions.Count == 0)
            {
                <div class="card"><p>Ainda não existem observações. Contacte a administração para importar os dados de treino.</p></div>
            }
            @foreach (var region in Model.Regions)
            {
                <div class="region-row">
                    <strong>@region.Name — @region.Province</strong>
                    <span>@region.ObservationCount observações · até @region.LatestObservationDate.ToString("dd/MM/yyyy")</span>
                </div>
            }
        </section>

        <h2 class="section-title">Acesso rápido</h2>
        <div class="grid">
            <section class="card">
                <div class="badge">Utilizador</div>
                <h2>Previsão</h2>
                <p>Escolha uma região e um horizonte de 1 a 12 meses para consultar a projeção baseada no histórico disponível.</p>
                <div class="button-row">
                    <a class="button" href="@Url.Action("Index", "Forecast")">Abrir previsão</a>
                    <a class="button secondary" href="@Url.Action("Index", "SoilObservations")">Ver observações</a>
                </div>
            </section>

            @if (User.IsInRole("Administrador"))
            {
                <section class="card">
                    <div class="badge">Administração</div>
                    <h2>Gestão do sistema</h2>
                    <p>Importe dados, execute a avaliação do classificador e consulte as métricas.</p>
                    <div class="button-row">
                        <a class="button secondary" href="@Url.Action("Index", "Admin")">Abrir administração</a>
                    </div>
                </section>
            }
        </div>
    </main>
</body>
</html>
