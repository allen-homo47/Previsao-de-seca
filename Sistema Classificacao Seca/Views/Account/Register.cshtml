@model Sistema_Classificacao_Seca.Controllers.RegisterViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Criar conta";
}
<!doctype html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Criar conta | Sistema de Previsão de Seca</title>
    <style>
        :root { --green: #14532d; --dark: #0f3d2b; --text: #183728; --muted: #587264; }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, 480px); font-family: "Segoe UI", Arial, sans-serif; color: var(--text); background: #f3faf4; }
        .story { padding: clamp(2rem, 7vw, 6rem); display: flex; flex-direction: column; justify-content: space-between; color: white; background: radial-gradient(circle at 85% 15%, rgba(134,191,115,.35), transparent 28%), linear-gradient(145deg, #0d3425, #17623b 72%, #398151); }
        .brand { color: white; font-weight: 800; letter-spacing: .03em; text-decoration: none; }
        .story-content { max-width: 650px; }
        .eyebrow { color: #b7e4c4; font-weight: 700; text-transform: uppercase; letter-spacing: .13em; font-size: .8rem; }
        h1 { font-size: clamp(2.4rem, 5vw, 4.7rem); line-height: 1.04; margin: 1rem 0; }
        .story p { color: #e0f0e5; line-height: 1.7; max-width: 560px; }
        .story-foot { color: #c9e0d0; font-size: .9rem; }
        .form-side { display: grid; place-items: center; padding: 2rem; }
        .form-card { width: min(100%, 390px); }
        .form-card h2 { font-size: 2rem; margin: 0 0 .4rem; color: var(--dark); }
        .intro { color: var(--muted); margin: 0 0 1.5rem; }
        label { display: block; font-weight: 650; margin: 1rem 0 .4rem; }
        input[type=email], input[type=password] { width: 100%; padding: .85rem 1rem; border: 1px solid #c8d8cf; border-radius: 10px; font-size: 1rem; background: white; }
        input:focus { outline: 3px solid #c6e7d0; border-color: var(--green); }
        .submit { width: 100%; border: 0; border-radius: 10px; padding: .9rem; margin-top: 1.2rem; color: white; background: var(--green); font-weight: 750; font-size: 1rem; cursor: pointer; }
        .submit:hover { background: var(--dark); }
        .validation-summary-errors, .field-validation-error { color: #a3212a; font-size: .92rem; }
        .validation-summary-errors ul { padding-left: 1.2rem; }
        .bottom { text-align: center; margin-top: 1.3rem; color: var(--muted); }
        a { color: var(--green); font-weight: 650; }
        .back { display: inline-block; margin-bottom: 2rem; text-decoration: none; }
        .hint { margin-top: .5rem; color: var(--muted); font-size: .86rem; }
        @@media (max-width: 760px) { body { grid-template-columns: 1fr; } .story { min-height: 260px; padding: 1.5rem; } .story-content { margin: 2rem 0; } .story h1 { font-size: 2.4rem; } .story-foot { display: none; } }
    </style>
</head>
<body>
    <aside class="story">
        <a class="brand" asp-controller="Home" asp-action="Index">SECA · MONITORIA</a>
        <div class="story-content">
            <span class="eyebrow">Acompanhamento ambiental</span>
            <h1>Uma visão clara para decisões melhores.</h1>
            <p>Crie uma conta para consultar os indicadores e a previsão de risco de seca nas regiões monitorizadas.</p>
        </div>
        <div class="story-foot">Chókwè e Massinga · Moçambique</div>
    </aside>
    <main class="form-side">
        <section class="form-card">
            <a class="back" asp-controller="Account" asp-action="Login">← Voltar ao início de sessão</a>
            <h2>Criar conta</h2>
            <p class="intro">Preencha os dados para aceder ao dashboard.</p>
            <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly"></div>
                <input asp-for="ReturnUrl" type="hidden" />
                <label asp-for="Email">E-mail</label>
                <input asp-for="Email" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email"></span>
                <label asp-for="Password">Palavra-passe</label>
                <input asp-for="Password" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
                <p class="hint">Use pelo menos 8 caracteres, com maiúscula, minúscula, número e símbolo.</p>
                <label asp-for="ConfirmPassword">Confirmar palavra-passe</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
                <button class="submit" type="submit">Registar e entrar</button>
            </form>
            <p class="bottom">Já tem conta? <a asp-controller="Account" asp-action="Login">Entrar</a></p>
        </section>
    </main>
</body>
</html>
